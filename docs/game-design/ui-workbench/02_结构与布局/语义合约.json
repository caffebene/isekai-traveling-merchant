      "placement": "right_of_customer",
      "after_last_line": "keep_open"
    },
    {
      "id": "recorder_window",
      "type": "draggable_window",
      "content": "completed_dialogue_history",
      "source": "phone_hotspot"
    },
    {
      "id": "computer_hotspot",
      "type": "scene_prop",
      "content": "open_trade_panel",
      "source": "assets/interaction/computer.png"
    },
    {
      "id": "phone_hotspot",
      "type": "scene_prop",
      "content": "open_phone_history",
      "source": "assets/interaction/phone.png"
    },
    {
      "id": "call_bell_hotspot",
      "type": "scene_prop",
      "content": "click_when_empty_or_hold_to_replace_customer",
      "source": "assets/interaction/call_bell.png"
    },
    {
      "id": "door_closer_hotspot",
      "type": "scene_prop",
      "content": "close_roller_shutter",
      "source": "assets/interaction/door_closer.png"
    },
    {
      "id": "roller_shutter",
      "type": "animated_scene_overlay",
      "content": "top_to_bottom_window_cover",
      "source": "assets/interaction/roller_shutter.png"
    }
