{
  "screen": "经营页",
  "fixed_layers": [
    "wagon_interior",
    "city_exterior",
    "customer_portrait"
  ],
  "runtime_slots": [
    {
      "id": "customer_bag",
      "type": "draggable_window",
      "size": "24x4",
      "owner": "customer",
      "source": "customer_inventory"
    },
    {
      "id": "counter",
      "type": "continuous_physics_surface",
      "owner": "mixed",
      "source": "tabletop"
    },
    {
      "id": "stock",
      "type": "grid",
      "size": "30x12",
      "owner": "player",
      "source": "lower_storage"
    },
    {
      "id": "trade_panel",
      "type": "draggable_window",
      "content": "customer_intent_and_purchase_sale_tabs"
    },
    {
      "id": "bag_window",
      "type": "draggable_window",
      "content": "6x6_grid",
      "source": "small_bag_item"
    },
    {
      "id": "machine_window",
      "type": "draggable_window",
      "content": "machine_grid_and_next_day_recipe",
      "independent_instances": true,
      "close_button_parent": "window_host"
    },
    {
      "id": "dialogue_box",
      "type": "runtime_dialogue_window",
      "content": "runtime_panel_typewriter_and_paging",
